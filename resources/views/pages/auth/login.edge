  <main class="auth-container">
    <div class="auth-card">
      <div class="logo-text">
        <span class="logo-flash">Flash</span>
        <span class="logo-dams">Dam's</span>
      </div>
      <h1>
        Connexion
      </h1>

      <form action="{{ route('auth.login') }}" method="POST">
        {{ csrfField() }}
        <div class="form-group">
          <label for="uid">Email ou Pseudo</label>
          <input type="text" name="uid" value="{{ old('uid') || '' }}" required />
          @if(flashMessages.has('errors.uid'))
            <span class="error">{{ flashMessages.get('errors.uid') }}</span>
          @end
          @if(flashMessages.has('errors'))
            <span class="error">{{ flashMessages.get('errors') }}</span>
          @end
        </div>

        <div class="form-group">
          <label for="password">Mot de passe</label>
          <input type="password" name="password" required />
        </div>

        {{-- NOUVEAU : Option de session persistante --}}
        <div class="form-group-remember">
          <label class="remember-label">
            <input type="checkbox" name="isRememberMe" />
            <span>Rester connecté</span>
          </label>
        </div>

        <button type="submit" class="btn-primary">Se connecter</button>
      </form>

      <p class="auth-footer">
        Pas de compte ? <a href="{{ route('auth.register') }}">S'inscrire</a>
      </p>
    </div>
  </main>
