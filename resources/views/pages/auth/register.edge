<!DOCTYPE html>
<html lang="fr">

  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @vite(['resources/css/app.css', 'resources/js/app.js', `resources/css/login.css`])
    <title>
      {{ "Register | Flash Dam\'s" }}
    </title>
  </head>
  <main class="auth-container">
    <div class="auth-card">
      <div class="logo-text">
        <span class="logo-flash">Flash</span>
        <span class="logo-dams">Dam's</span>
      </div>
      <h1>
        Créer un compte
      </h1>

      <form action="{{ route('auth.handleRegister') }}" method="POST" id="register-form">
        {{ csrfField() }}
        <div class="form-group">
          <label>Nom d'utilisateur</label>
          <input type="text" id="username" name="username" value="{{ old('username') || '' }}" />
          @if(flashMessages.has('errors.username'))
            <span class="error-msg">{{ flashMessages.get('errors.username') }}</span>
          @end
        </div>

        <div class="form-group">
          <label>Email</label>
          <input type="email" id="email" name="email" value="{{ old('email') || '' }}" />
          @if(flashMessages.has('errors.email'))
            <span class="error-msg">{{ flashMessages.get('errors.email') }}</span>
          @end
        </div>

        <div class="form-group">
          <label>Mot de passe (8 caractères min.)</label>
          <input type="password" id="password" name="password" />
          @if(flashMessages.has('errors.password'))
            <span class="error-msg">{{ flashMessages.get('errors.password') }}</span>
          @end
        </div>

        <div class="form-group">
          <label>Confirmer le mot de passe</label>
          <input type="password" id="password_confirmation" name="password_confirmation" />
        </div>
        <div class="form-group checkbox-group">
          <input type="checkbox" id="terms" name="terms" />
          <label for="terms">J'ai lu et j'accepte les <a href="{{ route('legal.index') }}">conditions d'utilisation</a></label>
          @if(flashMessages.has('errors.terms'))
            <span class="error-msg">{{ flashMessages.get('errors.terms') }}</span>
          @end
        </div>

        <button type="submit" id="submit-btn" class="btn-primary" disabled>S'inscrire</button>
      </form>

      <p class="auth-footer">
        Déjà inscrit ? <a href="{{ route('auth.login') }}">Se connecter</a>
      </p>
    </div>
  </main>
  <script>
    const registerForm = document.getElementById('register-form')
    const usernameInput = document.getElementById('username')
    const emailInput = document.getElementById('email')
    const passwordInput = document.getElementById('password')
    const confirmInput = document.getElementById('password_confirmation')
    const termsCheckbox = document.getElementById('terms')
    const submitBtn = document.getElementById('submit-btn')

    const updateSubmitState = () => {
      const canSubmit =
        usernameInput?.value.trim() &&
        emailInput?.value.trim() &&
        passwordInput?.value &&
        confirmInput?.value &&
        termsCheckbox?.checked

      submitBtn.disabled = !canSubmit
    }

    ;[usernameInput, emailInput, passwordInput, confirmInput].forEach((input) => {
      input?.addEventListener('input', updateSubmitState)
    })

    termsCheckbox?.addEventListener('change', updateSubmitState)
    updateSubmitState()
  </script>
  @!component('partials/footer', { })
