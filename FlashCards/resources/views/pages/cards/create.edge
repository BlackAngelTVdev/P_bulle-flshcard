@component('components/main', { title: `Créer une carte | Flash Dam\'s`, css: 'cardcreate' })
<main>
    <h1>Créer une nouvelle carte</h1>
    
    <form action="{{ route('cards.store') }}" method="POST" enctype="multipart/form-data" id="cardForm">
        {{ csrfField() }}

        {{-- On récupère le deckId soit de l'input, soit de la session (en cas de retour erreur) --}}
        <input type="hidden" name="deckId" value="{{ request.input('deckId') || old('deckId') || '' }}">

        <div class="form-group">
            <label for="question">Question (Manuel)</label>
            <input type="text" id="question" name="question" value="{{ old('question') || '' }}">
            @inputError('question')
                <p class="error-message" style="color: red; font-size: 0.8rem;"> {{ $messages.join(', ') }} </p>
            @end
        </div>

        <div class="form-group">
            <label for="answer">Réponse (Manuel)</label>
            <textarea id="answer" name="answer">{{ old('answer') || '' }}</textarea>
            @inputError('answer')
                <p class="error-message" style="color: red; font-size: 0.8rem;"> {{ $messages.join(', ') }} </p>
            @end
        </div>

        <div style="margin: 20px 0; text-align: center; font-weight: bold;">— OU —</div>
       
        <div class="form-group" style="background: #f4f4f4; padding: 15px; border-radius: 8px;">
            <label>📸 Générer via une photo de cours</label>
            <input type="file" name="courseImage" accept="image/*" id="imageInput">
            <p style="font-size: 0.7rem; color: #666; margin-top: 5px;">L'IA remplira automatiquement le deck à partir de l'image.</p>
        </div>

        <button type="submit" class="btn-submit" id="submitBtn">
            Enregistrer la carte
        </button>
    </form>
</main>

<script>
    // Petit script pour prévenir le double-clic et prévenir que l'IA bosse
    const form = document.getElementById('cardForm');
    const btn = document.getElementById('submitBtn');
    const fileInput = document.getElementById('imageInput');

    form.onsubmit = () => {
        if (fileInput.files.length > 0) {
            btn.innerText = "L'IA analyse ton cours... ⏳";
            btn.style.opacity = "0.7";
            btn.style.cursor = "not-allowed";
        }
    };
</script>
@end