@component('components/main', { title: `Modifier la carte | Flash Dam\'s`, css: 'cardedit' })
  <main class="card-edit-page">
    <form action="{{ route('cards.update', { id: card.id }) }}?_method=PUT" method="POST">
      {{ csrfField() }}
      <h1>
        Modifier la carte
      </h1>

      <div class="field">
        <label for="question">Question</label>
        <textarea
          id="question"
          name="question"
          placeholder="Écris la question. Pour une puce, commence une ligne par ()"
        >{{ old('question') || card.question }}</textarea>
        @if(flashMessages.has('errors.question'))
          <p class="text-danger">
            {{ flashMessages.get('errors.question') }}
          </p>
        @end
      </div>

      <div class="field">
        <label for="answer">Réponse</label>
        <textarea
          id="answer"
          name="answer"
          placeholder="Écris la réponse. Pour une puce, commence une ligne par ()"
        >{{ old('answer') || card.answer }}</textarea>
        <small class="field-help">
          Les puces apparaissent uniquement sur les lignes qui commencent par <strong>()</strong>.
        </small>
        @if(flashMessages.has('errors.answer'))
          <p class="text-danger">
            {{ flashMessages.get('errors.answer') }}
          </p>
        @end
      </div>

      <button type="submit">Enregistrer les modifications</button>

      <a href="{{ route('decks.show', { id: card.deckId }) }}" class="btn-abandon">
        Abandonner
        </a>
    </form>
  </main>
@end
