@component('components/main', { title: `Résultat | ${deck.name}`, css: 'result' })
<main>
    <div class="result-card">
        {{-- En-tête dynamique selon le score --}}
        @if(score == total)
            <h1>LÉGENDAIRE ! 👑</h1>
        @elseif(score == 0)
            <h1>AÏE... 💀</h1>
        @else
            <h1>Fini ! 🏆</h1>
        @endif

        <p class="deck-name">{{ deck.name }}</p>
        
        {{-- Badge du mode de jeu --}}
        <div class="mode-badge {{ mode }}">
            @if(mode === 'survie')
                Mode Survie 💀
            @elseif(mode === 'chrono')
                Mode Chrono ⏱️
            @else
                Mode Basique ✅
            @endif
        </div>

        {{-- Calcul du pourcentage --}}
        @let(percentage = (total > 0) ? (score / total) * 100 : 0)
        
        <div class="chart-container">
            <div class="pie-chart" style="background: conic-gradient(var(--primary-violet) {{ percentage }}%, #eee 0);">
                <div class="pie-center">
                    <span class="score-num">{{ score }}</span>
                    <span class="score-total">/ {{ total }}</span>
                </div>
            </div>
        </div>

        <p class="feedback-msg">
            @if(mode === 'survie' && score < total)
                @if(score == 0)
                    Même pas une carte ? Faut se réveiller ! 🧊
                @elseif(score < total / 2)
                    Éliminé ! Tu auras tenu au moins {{ score }} cartes. 🪦
                @else
                    Presque un sans-faute ! Tu as tenu {{ score }} cartes. 🔥
                @endif
            @elseif(mode === 'chrono')
                @if(percentage >= 80)
                    T'es rapide comme l'éclair ! ⚡
                @else
                    Le temps presse, entraîne ta vitesse ! ⏳
                @endif
            @else
                {{-- Messages mode Basique --}}
                @if(score == total)
                    Parfait ! T'es un monstre ! 🔥
                @elseif(score > total / 2)
                    Pas mal du tout ! 👏
                @else
                    Encore un peu d'entraînement... 💪
                @endif
            @endif
        </p>

        <div class="actions">
            {{-- On renvoie vers play pour pouvoir rechoisir le mode --}}
            <a href="{{ route('decks.play', { id: deck.id }) }}" class="btn-retry">Rejouer</a>
            <a href="{{ route('decks.show', { id: deck.id }) }}" class="btn-back">Retour au deck</a>
        </div>
    </div>
</main>
@end