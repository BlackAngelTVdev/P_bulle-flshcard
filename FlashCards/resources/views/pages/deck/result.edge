@component('components/main', { title: `Résultat | ${deck.name}`, css: 'result' })
<main>
    <div class="result-card">
        <h1>Fini ! 🏆</h1>
        <p class="deck-name">{{ deck.name }}</p>
        
        {{-- Calcul du pourcentage pour le camembert --}}
        @let(percentage = (score / total) * 100)
        
        <div class="chart-container">
            <div class="pie-chart" style="background: conic-gradient(#10b981 {{ percentage }}%, #ef4444 0);">
                <div class="pie-center">
                    <span class="score-num">{{ score }}</span>
                    <span class="score-total">/ {{ total }}</span>
                </div>
            </div>
        </div>

        <p class="feedback-msg">
            @if(score == total)
                Parfait ! T'es un monstre ! 🔥
            @elseif(score > total / 2)
                Pas mal du tout ! 👏
            @else
                Encore un peu d'entraînement... 💪
            @end
        </p>

        <div class="actions">
            <a href="{{ route('decks.game', { id: deck.id }) }}" class="btn-retry">Rejouer</a>
            <a href="{{ route('decks.show', { id: deck.id }) }}" class="btn-back">Retour au deck</a>
        </div>
    </div>
</main>
@end