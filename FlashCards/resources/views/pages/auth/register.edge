<script>
  const wrapper = document.querySelector('.card-wrapper');
  const currentFace = wrapper.dataset.face;
  const isMobile = window.innerWidth <= 768;

  const handleFlip = (e, targetUrl) => {
    e.preventDefault();
    
    // Sur mobile : Pas d'animation de flip, on change juste de page direct
    if (isMobile) {
        window.location.href = targetUrl;
        return;
    }

    // Sur Desktop : Animation de flip
    wrapper.classList.add('is-flipped');
    setTimeout(() => { window.location.href = targetUrl }, 500);
  };

  document.querySelectorAll('.face-tab').forEach(el => {
    el.addEventListener('click', (e) => {
      const targetUrl = el.getAttribute('href');
      const targetFace = targetUrl.includes('face=data') ? 'data' : 'cgu';
      
      if (targetFace !== currentFace) {
        handleFlip(e, targetUrl);
      } else {
        e.preventDefault();
      }
    });
  });

  // Init Desktop (Inversion instantanée au chargement)
  if (!isMobile && currentFace === 'data') {
    wrapper.classList.add('no-transition');
    wrapper.classList.add('is-flipped');
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        wrapper.classList.remove('no-transition');
      });
    });
  }
</script>
@!component('partials/footer', { })