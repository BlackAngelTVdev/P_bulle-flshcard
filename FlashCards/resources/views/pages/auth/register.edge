    <title>
        {{ "Register | Flash Dam\'s" }}
    </title>
</head>
<main class="auth-container">
    <div class="auth-card">
        <div class="logo-text">
            <span class="logo-flash">Flash</span>
            <span class="logo-dams">Dam's</span>
        </div>
        <h1>Créer un compte</h1>

        <form action="{{ route('auth.handleRegister') }}" method="POST">
            {{ csrfField() }}

            <div class="form-group">
                <label>Nom d'utilisateur</label>
                <input type="text" name="username" value="{{ old('username') || '' }}">
                @if(flashMessages.has('errors.username'))
                <span class="error-msg">{{ flashMessages.get('errors.username') }}</span>
                @end
            </div>

            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" value="{{ old('email') || '' }}">
                @if(flashMessages.has('errors.email'))
                <span class="error-msg">{{ flashMessages.get('errors.email') }}</span>
                @end
            </div>

            <div class="form-group">
                <label>Mot de passe (8 caractères min.)</label>
                <input type="password" name="password">
                @if(flashMessages.has('errors.password'))
                <span class="error-msg">{{ flashMessages.get('errors.password') }}</span>
                @end
            </div>

            <div class="form-group">
                <label>Confirmer le mot de passe</label>
                <input type="password" name="password_confirmation">
            </div>
            <div class="form-group checkbox-group">
                <input type="checkbox" id="terms" name="terms">
                <label for="terms">J'ai lu et j'accepte les <a href="#">conditions d'utilisation</a></label>
                @if(flashMessages.has('errors.terms'))
                <span class="error-msg">{{ flashMessages.get('errors.terms') }}</span>
                @end
            </div>

            <button type="submit" id="submit-btn" class="btn-primary" disabled>S'inscrire</button>
        </form>

        <p class="auth-footer">Déjà inscrit ? <a href="{{ route('auth.login') }}">Se connecter</a></p>
    </div>
</main>
<script>
    const termsCheckbox = document.getElementById('terms');
    const submitBtn = document.getElementById('submit-btn');

    termsCheckbox.addEventListener('change', function() {
        if (this.checked) {
            submitBtn.disabled = false;
            submitBtn.style.opacity = "1";
            submitBtn.style.cursor = "pointer";
        } else {
            submitBtn.disabled = true;
            submitBtn.style.opacity = "0.5";
            submitBtn.style.cursor = "not-allowed";
        }
    });
</script>
@!component('partials/footer', { })