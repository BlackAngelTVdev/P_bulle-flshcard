@component('components/main', { title: 'Inscription | Flash Dam\'s', css: 'auth' })
<main class="auth-container">
    <div class="auth-card">
        <h1>Créer un compte</h1>

        <form action="{{ route('auth.handleRegister') }}" method="POST">
            {{ csrfField() }}
            
            <div class="form-group">
                <label>Nom d'utilisateur</label>
                <input type="text" name="username" value="{{ old('username') || '' }}">
                @if(flashMessages.has('errors.username'))
                    <span class="error-msg">{{ flashMessages.get('errors.username') }}</span>
                @end
            </div>

            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" value="{{ old('email') || '' }}">
                @if(flashMessages.has('errors.email'))
                    <span class="error-msg">{{ flashMessages.get('errors.email') }}</span>
                @end
            </div>

            <div class="form-group">
                <label>Mot de passe (8 caractères min.)</label>
                <input type="password" name="password">
                @if(flashMessages.has('errors.password'))
                    <span class="error-msg">{{ flashMessages.get('errors.password') }}</span>
                @end
            </div>

            <div class="form-group">
                <label>Confirmer le mot de passe</label>
                <input type="password" name="password_confirmation">
            </div>

            <button type="submit" class="btn-primary">S'inscrire</button>
        </form>
        
        <p class="auth-footer">Déjà inscrit ? <a href="{{ route('auth.login') }}">Se connecter</a></p>
    </div>
</main>
@end