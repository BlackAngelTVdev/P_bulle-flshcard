@component('components/main', { title: 'Administration | Flash Dam\'s', css: 'admin' })
<main class="admin-page">
  <h1 class="admin-title">Panneau d'administration</h1>

  <section class="stats-grid">
    <article class="stat-card">
      <h2>Utilisateurs</h2>
      <p>{{ stats.users }}</p>
    </article>
    <article class="stat-card">
      <h2>Admins</h2>
      <p>{{ stats.admins }}</p>
    </article>
    <article class="stat-card">
      <h2>Decks</h2>
      <p>{{ stats.decks }}</p>
    </article>
    <article class="stat-card">
      <h2>Cartes</h2>
      <p>{{ stats.cards }}</p>
    </article>
    <article class="stat-card">
      <h2>Connectes maintenant</h2>
      <p data-connected-users-count>{{ stats.connectedUsers }}</p>
    </article>
  </section>




  <section class="admin-block" id="connected-users-panel" data-users-url="{{ route('admin.connectedUsers.index') }}" data-disconnect-url-template="{{ route('admin.connectedUsers.disconnect', { id: '__USER_ID__' }) }}">
    <h2>Utilisateurs connectes en ce moment</h2>
    <p class="live-note">Mise a jour automatique toutes les 5 secondes.</p>
    <p class="empty" data-connected-users-empty style="{{ connectedUsers.length ? 'display:none;' : '' }}">Aucun utilisateur actif.</p>
    <div class="table-wrap" data-connected-users-table-wrap style="{{ connectedUsers.length ? '' : 'display:none;' }}">
      <table class="admin-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Utilisateur</th>
            <th>Email</th>
            <th>Role</th>
            <th>Derniere activite</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody data-connected-users-body>
          @each(row in connectedUsers)
            <tr>
              <td>#{{ row.id }}</td>
              <td>{{ row.username || '-' }}</td>
              <td>{{ row.email || '-' }}</td>
              <td>
                @if(row.is_admin)
                  <span class="badge-admin">Admin</span>
                @else
                  <span class="badge-user">User</span>
                @endif
              </td>
              <td>{{ row.last_seen_at }}</td>
              <td>
                @if(auth.user && auth.user.id === row.id)
                  <span class="self-pill">Toi</span>
                @else
                  <button type="button" class="btn-danger js-disconnect-user" data-user-id="{{ row.id }}">Deconnecter</button>
                @endif
              </td>
            </tr>
          @end
        </tbody>
      </table>
    </div>
  </section>

  <section class="admin-block">
    <h2>Comptes utilisateurs</h2>
    @if(users.length)
      <div class="table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Nom</th>
              <th>Email</th>
              <th>Rôle</th>
              <th>Créé le</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            @each(row in users)
              <tr>
                <td>#{{ row.id }}</td>
                <td>{{ row.username || '-' }}</td>
                <td>{{ row.email }}</td>
                <td>
                  @if(row.is_admin)
                    <span class="badge-admin">Admin</span>
                  @else
                    <span class="badge-user">User</span>
                  @endif
                </td>
                <td>{{ row.created_at }}</td>
                <td>
                  <form method="POST" action="{{ route('admin.users.destroy', { id: row.id }) }}?_method=DELETE" onsubmit="return confirm('Résilier ce compte ? Cette action est définitive.')">
                    {{ csrfField() }}
                    <input type="hidden" name="_method" value="DELETE">
                    <button type="submit" class="btn-danger">Résilier compte</button>
                  </form>
                </td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    @else
      <p class="empty">Aucun utilisateur.</p>
    @end
  </section>
</main>
@end
